# VeriRAG environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required: LLM provider (DeepSeek via OpenAI-compatible API) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# --- Optional API keys ---
LANGSMITH_API_KEY=lsv2_...
TAVILY_API_KEY=tvly-...

# --- Observability ---
LANGSMITH_PROJECT=verirag
SUMMARIZATION_CONTEXT_MAX_CHARS=24000
SUMMARIZATION_BATCH_MAX_CHARS=12000
METRICS_DB_PATH=./data/metrics.db
ESTIMATED_COST_PER_LLM_CALL_USD=0.002

# --- Models (override to swap models) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Document loading / figures ---
MIN_FIGURE_DIMENSION_PX=150
PARENT_TEXT_MAX_CHARS=6000

# --- Chunking ---
CHUNK_MIN_TOKENS=150
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Vector store (dense) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=verirag_chunks

# --- Sparse index (BM25) ---
BM25_CORPUS_PATH=./data/processed/bm25_corpus.jsonl

# --- External fallback (web search) ---
EXTERNAL_MAX_RESULTS=3
TAVILY_SEARCH_DEPTH=basic
EXTERNAL_SOURCE_SCORE_PENALTY=0.9

# --- Hybrid retrieval ---
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATE_CAP=20
RETRIEVAL_FINAL_TOP_K=5

# --- Critic: Gate 1 (coverage) ---
# Placeholder thresholds; calibrated in Phase 12, not hand-tuned.
GATE1_HIGH_THRESHOLD=0.5
GATE1_LOW_THRESHOLD=0.05

# --- Critic: Gate 2 (groundedness) ---
# Placeholder threshold; calibrated in Phase 12.
GATE2_ENTAILMENT_THRESHOLD=0.5
GATE2_COMBINATION_MAX_CHARS=2000

# --- Critic / corrective loop ---
MAX_CRITIC_ITERATIONS=2
MAX_LLM_CALLS_PER_QUERY=10
PER_QUERY_COST_CEILING_USD=0.50
