# VeriRAG environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required: LLM provider (DeepSeek via OpenAI-compatible API) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# --- Optional API keys ---
LANGSMITH_API_KEY=lsv2_...
TAVILY_API_KEY=tvly-...

# --- Observability ---
LANGSMITH_PROJECT=verirag

# --- Models (override to swap models) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Document loading / figures ---
MIN_FIGURE_DIMENSION_PX=150

# --- Chunking ---
CHUNK_MIN_TOKENS=150
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Critic / corrective loop ---
MAX_CRITIC_ITERATIONS=2
PER_QUERY_COST_CEILING_USD=0.50
